<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!--
	  Eksportkontroll. Uten denne nøkkelen stopper hvert eneste bygg i App Store
	  Connect med «Missing Compliance», og du må svare på spørsmålet manuelt før
	  bygget kan velges til innsending.

	  `false` er riktig her: appen bruker bare HTTPS (standard TLS via WKWebView
	  og fetch), og det er unntatt fra amerikansk eksportregelverk. Vi har ingen
	  egen kryptografi. Legger noen inn egen kryptering senere, må dette endres.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Mycelet bruker kameraet til å ta bilde av sopp du vil identifisere.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Mycelet trenger tilgang til bildene dine for å velge et soppbilde til identifisering.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Mycelet kan lagre soppbilder i bildebiblioteket ditt.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Mycelet bruker posisjonen din til å vise funn i nærheten og gi bedre soppvarsel for området ditt.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>nb</string>
	<!-- Språkene appen faktisk leverer. Apple leser «Språk»-raden på
	     App Store-produktsiden fra BUNTEN, ikke fra metadataen i App Store
	     Connect (Technical Q&A QA1828). Uten denne nøkkelen oppga den
	     svenske produktsiden «Norsk bokmål» som eneste språk — under en
	     helt svensk butikktekst, for en app der hele UI-et, været (SMHI),
	     artsnavnene og personvernsiden er svenske.

	     QA1828 sier at .lproj-mappene i bunten bestemmer lista, og at
	     CFBundleLocalizations gjelder for apper som IKKE bruker .lproj til
	     lokaliserte ressurser. Dette skallet er nettopp det: all tekst
	     kommer fra web-appen på www.mycelet.com, så det finnes ingen
	     lokaliserte ressurser å legge i en sv.lproj.

	     BEGGE språkene må stå her, aldri nb alene: iOS' per-app-språkvalg
	     finnes bare for apper som erklærer flere språk, og det er den
	     overstyringen som avgjør hvilken Accept-Language WKWebView sender
	     — altså hva src/i18n/locale.ts lander på. Lista holdes i takt med
	     LOCALES i src/i18n/config.ts av en test:
	     src/lib/__tests__/ios-sprakerklaering.test.ts -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>nb</string>
		<string>sv</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>Mycelet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>WKAppBoundDomains</key>
	<array>
		<string>mycelet.com</string>
		<string>www.mycelet.com</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
