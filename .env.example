# Kopier til .env.local og fyll inn. Aldri ekte verdier i denne fila — repoet er offentlig.
# Står en verdi tom her, er funksjonen av til den fylles inn: koden er inert uten nøkkel, med vilje.
# Linjer med # foran er valgfrie. La dem stå kommentert om du ikke trenger dem — for flere av
# dem ville en TOM verdi overstyrt standarden i koden.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# Plant.id / Kindwise
PLANTID_API_KEY=your-api-key-here

# OpenWeatherMap
OPENWEATHER_API_KEY=your-api-key-here

# MET Frost, observert vær i Norge. Tom: Norge henter vær fra OpenWeather eller Open-Meteo.
MET_FROST_CLIENT_ID=

# Stripe (betaling)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxx
STRIPE_PRICE_SEASON_PASS=price_xxxxx

# RevenueCat (kjøp i iOS-appen)
# Offentlig SDK-nøkkel for Apple (appl_…). Tom: kjøp i appen er av.
NEXT_PUBLIC_REVENUECAT_APPLE_KEY=
# Authorization-verdien RevenueCat sender til /api/revenuecat/webhook. Tom: ruta svarer 503.
REVENUECAT_WEBHOOK_AUTH=
# 1 = sandbox-kjøp (TestFlight og App Review) gir Premium. Tom: sandbox-hendelser ignoreres.
REVENUECAT_ALLOW_SANDBOX=
# Produkt-ID-ene, bare når de avviker fra standarden i src/lib/billing/revenuecat.ts.
# REVENUECAT_PRODUCT_PREMIUM_MONTHLY=
# REVENUECAT_PRODUCT_SEASON_PASS=

# E-post (Resend). Tom: appen sender ingen e-post selv; glemt passord bruker Supabase sin egen.
RESEND_API_KEY=
# Avsenderen, på domenet som er verifisert hos Resend.
RESEND_FROM=

# Delt hemmelighet for /api/cron/* (Vercel sender den som Bearer). Tom: alle cron-ruter svarer 401.
CRON_SECRET=

# X (@mycelet): de fire nøklene fra X-utviklerportalen. Tomme: xpost-cronen poster ingenting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Mottakeren av pressevarselet når et område snur (xpost-cronen). Tom: ingen pressevarsel.
PRESSE_VARSEL_TIL=

# App
# Adressen i lenker i e-post og i Stripe-returen. Lokalt localhost; i Vercel Production https://www.mycelet.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Loggnivå: trace, debug, info, warn eller error. Uten den: debug i dev, info i prod.
# LOG_LEVEL=debug

# Analyse. Uten den brukes måle-ID-en i src/lib/analytics.ts; GA lastes bare etter samtykke.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (feilovervåking). DSN-en er IKKE hemmelig — den ligger i klientkoden.
# Settes kun i Vercel Production, så Sentry er automatisk av i dev og preview.
NEXT_PUBLIC_SENTRY_DSN=
# Egen DSN for server og edge. Uten den brukes NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# Kun for opplasting av source maps under bygg. SENTRY_AUTH_TOKEN gir skrivetilgang og
# hører hjemme i .env.sentry-build-plugin, som er gitignorert — IKKE legg den her lokalt.
SENTRY_ORG=
SENTRY_PROJECT=

# QA-brukeren: `npm run qa:setup` skriver QA_TEST_EMAIL og QA_TEST_PASSWORD inn i .env.local
# selv. Ikke legg dem inn for hånd — en tom linje får skriptet til å tro at de alt finnes.

# Analyseskriptene i scripts/ tar egne kjørevalg (CUTOFF, LIMIT, REGION …) foran kommandoen — se
# skriptet. Ikke her: tomme i .env.local ville `node --env-file` gitt dem "" i stedet for standarden.
