# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# Plant.id / Kindwise
PLANTID_API_KEY=your-api-key-here

# OpenWeatherMap
OPENWEATHER_API_KEY=your-api-key-here

# Stripe (betaling)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxx
STRIPE_PRICE_SEASON_PASS=price_xxxxx

# App
NEXT_PUBLIC_APP_URL=https://soppjakt.no
NEXT_PUBLIC_MAP_STYLE=https://tiles.stadiamaps.com/styles/outdoors.json

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=xxxxx

# Sentry (feilovervåking). DSN-en er IKKE hemmelig — den ligger i klientkoden.
# Settes kun i Vercel Production, så Sentry er automatisk av i dev og preview.
NEXT_PUBLIC_SENTRY_DSN=
# Kun for opplasting av source maps under bygg. IKKE legg den her lokalt —
# den hører hjemme i .env.sentry-build-plugin, som er gitignorert.
SENTRY_ORG=
SENTRY_PROJECT=
