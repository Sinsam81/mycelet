{
  "name": "mycelet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "calibrate:season-windows": "node --env-file=.env.local scripts/generate-season-windows.mjs",
    "calibrate:spot-feedback": "node --env-file=.env.local scripts/analyze-spot-feedback.mjs",
    "calibrate:fit-score": "node --env-file=.env.local scripts/fit-score-calibration.mjs",
    "backtest:phenology": "node --env-file=.env.local scripts/backtest-phenology.mjs",
    "backtest:full-pipeline": "node --env-file=.env.local scripts/backtest-full-pipeline.mjs",
    "features:occurrence-weather": "node --env-file=.env.local scripts/build-occurrence-weather-features.mjs",
    "fit:weather-preferences": "node --env-file=.env.local scripts/fit-weather-preferences.mjs",
    "fit:sdm-logistic": "node scripts/fit-sdm-logistic.mjs",
    "validation:preflight": "node scripts/preflight-prediction-validation.mjs",
    "validation:all": "node scripts/run-prediction-validation.mjs",
    "validation:report": "node scripts/summarize-prediction-validation.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "qa": "PLAYWRIGHT_BASE_URL=http://localhost:3000 node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "qa:prod": "playwright test --project=public",
    "qa:setup": "node --env-file=.env.local scripts/qa-create-test-user.mjs",
    "qa:report": "playwright show-report",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.3.4",
    "@revenuecat/purchases-capacitor": "13.2.4",
    "@sentry/nextjs": "10.69.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.53.0",
    "@tanstack/react-query": "^5.85.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.542.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.3",
    "stripe": "^16.12.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^22.17.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
